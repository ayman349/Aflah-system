# --- Required ---
# PostgreSQL connection string (local Postgres, Supabase "connection string", Neon, Railway, etc.)
DATABASE_URL=postgres://aflax:change-me@localhost:5432/aflax
# Set to true for hosted databases that require SSL (Supabase, Neon, Render...)
DATABASE_SSL=false
# Public address of the site. Use https:// in production (this turns on Secure cookies).
APP_URL=http://localhost:3000

# --- Uploads (must be on a persistent disk/volume in production) ---
UPLOAD_DIR=./storage
MAX_VIDEO_MB=500
MAX_PDF_MB=50
MAX_IMAGE_MB=5
MAX_ATTACHMENT_MB=25

# --- Only used by `npm run admin:create` (remove afterwards) ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional public contact details (shown in the footer only if set) ---
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
